/-! The round trip, repeated inside Lean: rendering the decoded values
reproduces the block the digest covers. -/
#guard (registry.map Rule.render).foldr (fun l acc => l ++ "\n" ++ acc) "" == registryText

/-! The earlier revision is a prefix, in the rule values and in the
bytes the earlier digest covers. -/
#guard ((registry.take registryPrefixCount).map Rule.render).foldr (fun l acc => l ++ "\n" ++ acc) "" == registryPrefixText

#guard registryText.startsWith registryPrefixText

end EvoIR
