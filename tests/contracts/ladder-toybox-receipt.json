  "sysroot": [
   {
    "file": "usr/include/aarch64-linux-gnu/bits/floatn-common.h",
    "change": "__HAVE_FLOAT32, __HAVE_FLOAT64 and __HAVE_FLOAT32X set to 0",
    "why": "the TS 18661 _FloatN types are not in the front end's type system, and their prototypes derail the parse of <stdlib.h>"
   },
   {
    "file": "usr/include/aarch64-linux-gnu/bits/floatn.h",
    "change": "__HAVE_FLOAT128 set to 0",
    "why": "same, for _Float128"
   },
   {
    "file": "usr/include/aarch64-linux-gnu/bits/math-vector.h",
    "change": "the AdvSIMD and SVE guards are forced closed",
    "why": "the SIMD math prototypes are written in GCC's built-in vector types (__Float32x4_t, __SVFloat32_t), which the front end has no syntax for"
   },
   {
    "file": "every exported header",
    "change": "form feeds and vertical tabs are deleted",
    "why": "C makes both white space (C11 6.4p1); the front end reports a form feed as a stray token, and glibc's regex.h uses one as a page break, which alone refuses every unit that includes it"
   },
   {
    "file": "gccinc/stdint.h",
    "change": "renamed out of the search path",
    "why": "it is a wrapper whose whole body is `#include_next <stdint.h>`, and the front end ignores #include_next, so keeping it hides the C library's real stdint.h and leaves intmax_t undeclared"
   }
  ],
  "defines": [
   "-D__extension__=",
   "-D__STDC_NO_VLA__=1"
  ],
  "unitsNotSubstitutable": [
   "the object built from main.c"
  ]
