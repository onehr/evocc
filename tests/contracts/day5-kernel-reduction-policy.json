  "overlayPolicy": {
    "manifestPath": "overlay.json",
    "rootExactKeys": ["policyId", "records", "schemaVersion", "sourceEvidenceRunId"],
    "recordExactKeys": ["candidate", "failureId", "state"],
    "inputState": "CANDIDATE",
    "verifierOnlyState": "VERIFIED",
    "oneRecordPerFailureId": true,
    "candidatePathsUniqueAndConfined": true,
    "symbolicLinks": "PROHIBITED",
    "hardLinks": "PROHIBITED",
    "overlaySuppliedOracleReplayArgvEnvironmentTimeoutOrReceipt": "PROHIBITED",
    "parserCandidate": {
      "kind": "preprocessed-parser",
      "exactKeys": ["bytes", "kind", "lineage", "path", "sha256"],
      "lineageEntryExactKeys": ["candidateLine", "seedLine", "seedLineSha256"],
      "lineage": "Candidate physical lines, including their terminators, must be a nonempty in-order deletion-only subsequence of the obligation's verified artifacts.parserInput seed. Line numbers are one-based and bijective.",
      "minimality": "preprocessed-line-1-minimal-v1"
    },
    "rawCandidate": {
      "kind": "raw-closure",
      "exactKeys": ["bundleSha256", "kind", "referenceClosures", "rootSourcePath", "subjectClosure"],
      "closureExactKeys": ["closureSha256", "files", "root", "seedFamily"],
      "fileExactKeys": ["bytes", "lineage", "logicalPath", "sha256"],
      "lineageEntryExactKeys": ["candidateLine", "seedLine", "seedLineSha256"],
      "closureEncoding": "sorted logicalPath<TAB>sha256<TAB>bytes<LF>",
      "bundleEncoding": "canonical JSON of rootSourcePath, subjectClosure closureSha256/root/seedFamily, and both sorted referenceClosures closureSha256/root/seedFamily values",
      "storageLayout": "For failureId F, subjectClosure file bytes are stored under candidates/F/subject/<logicalPath>, referenceClosures.gcc under candidates/F/reference-gcc/<logicalPath>, and referenceClosures.clang under candidates/F/reference-clang/<logicalPath>. logicalPath is a normalized source/<path> or output/<path> and cannot escape its derived directory. The overlay cannot supply or override a physical path. Each closure.root is the logical source/<rootSourcePath>, not a physical directory.",
      "subjectClosure": "Derived only from the exact verified inputs/<tuId>.gcc.inputs.tsv captured by the source run and executed by EvoCPP.",
      "referenceClosures": {
        "gcc": "Derived independently from the exact frozen gcc-lane-1 command record and input closure.",
        "clang": "Derived independently from the exact frozen clang-lane-1 command record and input closure. It must not reuse the GCC output closure or argv."
      },
      "sharedSourceInvariant": "Every retained source/<path> must exist in both family seeds with byte-identical seed bytes and use the same line selection in subject, GCC, and Clang closures. Family-specific output/<path> files may differ and carry separate lineage/digests. A logical path with conflicting source bytes is rejected.",
      "rootInvariant": "rootSourcePath equals the obligation sourcePath; each closure root equals source/<rootSourcePath>; that root logicalPath occurs exactly once in each closure; every logicalPath is unique; bundleSha256 binds rootSourcePath and all three closure identities.",
      "lineage": "Every retained file is a nonempty in-order deletion-only physical-line subsequence of its own verified family seed file. Every physical line, including a blank line and its terminator, is an atom.",
      "minimality": "raw-closure-file-and-line-1-minimal-v1"
    }
  },
  "replayPolicy": {
    "baselineReplayCount": 3,
    "requiredStableReplays": 3,
    "parserCommand": ["<verified-subject>", "--parse-only", "--target=aarch64-unknown-linux-gnu", "<private-candidate>"],
    "rawCommand": "The obligation's verified evocpp-raw argv; rewrite only the subject executable, source root, GCC output root, and root-source path to verifier-created private candidate paths.",
    "timeouts": {
      "parser": "run-config.json parserTimeoutSecondsPerTu",
      "raw": "run-config.json generalTimeoutSeconds"
    },
    "environment": {
      "LANG": "C",
      "LC_ALL": "C",
      "TZ": "UTC",
      "SOURCE_DATE_EPOCH": "build-environment.json reproducibility.SOURCE_DATE_EPOCH",
      "HOME": "fresh private verifier directory",
      "TMPDIR": "fresh private verifier directory"
    },
    "normalizedObservationFields": [
      "classification",
      "diagnostic.code",
      "diagnostic.message",
      "diagnostic.sourcePath",
      "diagnostic.sourceSpan.line",
      "diagnostic.sourceSpan.column",
      "phase",
      "returnCode",
      "timedOut"
    ],
    "originalAnchorFields": ["lane", "sourcePath", "tuId"],
    "stableReplayExactFields": [
      "argvSha256",
      "candidateDigest",
      "environmentSha256",
      "returnCode",
      "stderrSha256",
      "stdoutSha256",
      "subjectSha256",
      "timedOut"
    ],
    "stableReplayRule": "All three fresh subject executions must have byte-identical stableReplayExactFields. The verifier separately derives and compares the normalized causal signature; normalized equality never substitutes for byte-exact stdout/stderr, argv, environment, or candidate identity.",
    "sourceFailureReproduction": "The verifier independently derives the frozen failure signature from source results and requires the candidate's three normalized subject observations to be byte-identical to it. This is only reproduction evidence, never an oracle or an acceptance verdict. An overlay cannot supply or override this digest.",
    "causalAnchor": {
      "parser": "Bind the complete frozen source record, parserInput descriptor, diagnostic emitted line/column, exact seed-line bytes at that coordinate, and the corresponding captured line-map row. A candidate diagnostic is valid only when its deletion-only lineage maps the emitted token back to that same seed coordinate and then to the frozen sourcePath/sourceSpan; matching only code/message/source line is insufficient.",
      "raw": "Bind the complete frozen source record, exact seed-closure logical path and file digest containing the emitted diagnostic, and the diagnostic's physical seed line/column. A private candidate must map its emitted diagnostic back to that same retained seed coordinate; matching only E0104 or the normalized header path is insufficient.",
      "overlayMaySupplyAnchor": false,
      "sourceRecordSha256BindsOriginalEmittedFacts": true
    },
    "minimality": "After the stable baseline, independently evaluate every single allowed atom deletion with the complete interestingness predicate: the exact causally anchored subject failure is reproduced and both pinned compilers accept the exact deleted candidate bytes. Zero deletion may satisfy that conjunction. A deletion that preserves the subject failure but breaks either oracle is not removable. This is only the named line/file 1-minimal claim, never token or global minimality."
  },
  "referenceAcceptance": {
    "authority": "Both independently identified compilers must execute inside the exact sealed image. Host lookalikes, tags, one-compiler success, source-signature replay, and overlay assertions are not acceptance evidence.",
    "imageIdentity": "Before and after every compiler invocation, inspect the run-unique container and require sourceEvidence.executionAuthority.sealedImageId. Delete the run-unique alias after use.",
    "compilerIdentity": "Inside the sealed image, require exact path, version string, binary SHA-256, and different GCC/Clang binary digests from sourceEvidence.executionAuthority.referenceCompilers.",
    "network": "none",
    "exactCandidateBytes": true,
    "parserCommands": {
