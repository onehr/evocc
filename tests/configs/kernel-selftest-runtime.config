# Apply after the original per-collection selftest configs, in a separate
# coverage build. Do not alter the accepted K6 or an active kernel build.
# kvm/config and bpf/config.aarch64 require the idle-page tracking interface.
CONFIG_IDLE_PAGE_TRACKING=y
# bpf/config requests these algorithms but not their menu dependency.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_DCTCP=y
# mm/config requests the HMM test; its device-memory dependency is not default.
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_TEST_HMM=m
# iommu's nested/PASID fault cases use the IOPF queue. IOMMU_IOPF itself
# is a hidden Kconfig symbol; select it through the arm64 SMMUv3 SVA option.
CONFIG_ARM_SMMU_V3=y
CONFIG_ARM_SMMU_V3_SVA=y
