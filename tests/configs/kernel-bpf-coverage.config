# Apply after the upstream bpf, hid and sched_ext selftest config fragments.
# Keep this separate from the KUnit Image: overflow_kunit's foo/bar type names
# collide with BPF test declarations in the generated vmlinux.h.
# CONFIG_KUNIT is not set
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_NET_SCH_BPF=y
CONFIG_SCHED_CLASS_EXT=y
