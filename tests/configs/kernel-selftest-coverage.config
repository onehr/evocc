# Additional coverage for the already measured arm64 KUnit configuration.
# This is a separate test configuration, not a change to the K6 denominator.
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_MODULE_ALLOW_BTF_MISMATCH is not set
CONFIG_CFS_BANDWIDTH=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_USERFAULTFD=y
CONFIG_SECURITY_LANDLOCK=y
# MSEAL_SYSTEM_MAPPINGS excludes CHECKPOINT_RESTORE; test it separately.
CONFIG_SND_UTIMER=y
CONFIG_NTSYNC=m
CONFIG_IOMMUFD=m
CONFIG_FAULT_INJECTION=y
CONFIG_IOMMUFD_TEST=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
