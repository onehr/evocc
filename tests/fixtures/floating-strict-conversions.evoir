func @strict_trunc(%arg0: f64, %arg1: mem<all>, %arg2: world) -> (bits<8>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, fenv=true, may_trap=false, may_unwind=false }
{
^entry(%v0: f64, %v1: mem<all>, %v2: world):
    (%v3, %v4) = fp.strict.to_signed %v2, %v0 : bits<8>
    ret %v3, %v1, %v4
}

func @defined_only(%arg0: f64, %arg1: mem<all>, %arg2: world) -> (bits<1>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, fenv=false, may_trap=false, may_unwind=false }
{
^entry(%v0: f64, %v1: mem<all>, %v2: world):
    %v3 = fp.to_int_defined.s8 %v0 : bits<1>
    ret %v3, %v1, %v2
}
