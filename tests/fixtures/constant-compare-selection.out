  CARGO_TARGET_DIR=target/pinned-check CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0
  CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_NET_OFFLINE=true
  cargo test -p evocc-mir -p evocc --test constant_compare_selection
