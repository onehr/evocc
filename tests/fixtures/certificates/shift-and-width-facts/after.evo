func @widths(%arg0: bits<32>, %arg1: bits<32>, %arg2: mem<all>, %arg3: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, may_trap=true, may_unwind=false }
{
^entry(%v0: bits<32>, %v1: bits<32>, %v2: mem<all>, %v3: world):
    %v4 = const.bits<32> 0
    %v5 = const.bits<32> 0
    %v6 = const.bits<32> 3
    %v7 = shift_count_defined.signed %v4, %v6
    ub.assume.invalid_shift_count %v7
    %v8 = const.bits<32> 3
    %v9 = shift_count_defined.signed %v4, %v8
    ub.assume.invalid_shift_count %v9
    %v10 = const.bits<32> 3
    %v11 = shift_count_defined.signed %v4, %v10
    ub.assume.invalid_shift_count %v11
    %v12 = const.bits<64> 0
    %v13 = const.bits<64> 0
    %v14 = const.bits<8> 0
    ret %v4, %v2, %v3
}

func @main(%arg0: mem<all>, %arg1: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, may_trap=true, may_unwind=false }
{
^entry(%v0: mem<all>, %v1: world):
    %v2 = const.bits<32> 4660
    %v3 = const.bits<32> 5
    %v4 = const.bits<32> 0
    %v5 = signed_sub_defined %v4, %v3
    ub.assume.signed_overflow %v5
    %v6 = const.bits<32> 4294967291
    (%v7, %v8, %v9) = call @widths(%v2, %v6, %v0, %v1)
    %v10 = const.bits<32> 1000
    %v11 = divisor_nonzero %v10
    ub.assume.remainder_by_zero %v11
    %v12 = urem.bits<32> %v7, %v10
    ret %v12, %v8, %v9
}
