func @widths(%arg0: bits<32>, %arg1: bits<32>, %arg2: mem<all>, %arg3: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, may_trap=true, may_unwind=false }
{
^entry(%v0: bits<32>, %v1: bits<32>, %v2: mem<all>, %v3: world):
    %v4 = const.bits<32> 0
    %v5 = and.bits<32> %v0, %v4
    %v6 = const.bits<32> 0
    %v7 = and.bits<32> %v1, %v6
    %v8 = const.bits<32> 3
    %v9 = shift_count_defined.signed %v5, %v8
    ub.assume.invalid_shift_count %v9
    %v10 = shl.bits<32> %v5, %v8
    %v11 = const.bits<32> 3
    %v12 = shift_count_defined.signed %v5, %v11
    ub.assume.invalid_shift_count %v12
    %v13 = lshr.bits<32> %v5, %v11
    %v14 = const.bits<32> 3
    %v15 = shift_count_defined.signed %v7, %v14
    ub.assume.invalid_shift_count %v15
    %v16 = ashr.bits<32> %v7, %v14
    %v17 = zext.bits<64> %v5
    %v18 = sext.bits<64> %v7
    %v19 = trunc.bits<8> %v5
    %v20 = add.bits<32> %v10, %v13
    %v21 = add.bits<32> %v20, %v16
    %v22 = trunc.bits<32> %v17
    %v23 = add.bits<32> %v21, %v22
    %v24 = trunc.bits<32> %v18
    %v25 = add.bits<32> %v23, %v24
    %v26 = zext.bits<32> %v19
    %v27 = add.bits<32> %v25, %v26
    ret %v27, %v2, %v3
}

func @main(%arg0: mem<all>, %arg1: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, may_trap=true, may_unwind=false }
{
^entry(%v0: mem<all>, %v1: world):
    %v2 = const.bits<32> 4660
    %v3 = const.bits<32> 5
    %v4 = const.bits<32> 0
    %v5 = signed_sub_defined %v4, %v3
    ub.assume.signed_overflow %v5
    %v6 = sub.bits<32> %v4, %v3
    (%v7, %v8, %v9) = call @widths(%v2, %v6, %v0, %v1)
    %v10 = const.bits<32> 1000
    %v11 = divisor_nonzero %v10
    ub.assume.remainder_by_zero %v11
    %v12 = urem.bits<32> %v7, %v10
    ret %v12, %v8, %v9
}
