func @private_loop(%arg0: bits<32>, %arg1: bits<32>, %arg2: mem<all>, %arg3: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={all}, writes={all}, volatile=false, atomic=false, io=false, fenv=false, may_trap=true, may_unwind=false }
{
^entry(%v0: bits<32>, %v1: bits<32>, %v2: mem<all>, %v3: world):
    (%v4, %v5, %v6) = alloca %v2, %v3 [origin=3, size=4, align=4]
    %v7 = access_in_bounds %v5, %v4 [size=4, align=4]
    (%v8, %v9) = store %v7, %v6, %v4, %v1
    br ^b1(%v0, %v4, %v8, %v9)

^b1(%v10: bits<32>, %v11: ptr<generic>, %v12: mem<all>, %v13: world):
    %v14 = const.bits<32> 0
    %v15 = icmp.ne %v10, %v14
    cond_br %v15, ^b2(%v10, %v11, %v12, %v13), ^b3(%v11, %v12, %v13)

^b2(%v16: bits<32>, %v17: ptr<generic>, %v18: mem<all>, %v19: world):
    %v20 = access_in_bounds %v18, %v17 [size=4, align=4]
    (%v21, %v22, %v23) = load %v20, %v19, %v17 : bits<32>
    %v24 = const.bits<32> 1
    %v25 = add.bits<32> %v21, %v24
    %v26 = sub.bits<32> %v16, %v24
    %v27 = access_in_bounds %v22, %v17 [size=4, align=4]
    (%v28, %v29) = store %v27, %v23, %v17, %v25
    br ^b1(%v26, %v17, %v28, %v29)

^b3(%v30: ptr<generic>, %v31: mem<all>, %v32: world):
    %v33 = access_in_bounds %v31, %v30 [size=4, align=4]
    (%v34, %v35, %v36) = load %v33, %v32, %v30 : bits<32>
    (%v37, %v38) = lifetime.end %v35, %v36, %v30
    ret %v34, %v37, %v38
}
