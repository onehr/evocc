    (%v7, %v8) = store %v6, %v5, %v3, %v0
    (%v9, %v10, %v11) = call @private_word(%v0, %v7, %v8)
    %v12 = access_in_bounds %v10, %v3 [size=4, align=4]
    (%v13, %v14, %v15) = load %v12, %v11, %v3 : bits<32>
