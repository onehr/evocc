func @private_keep(%arg0: bits<32>, %arg1: bits<32>, %arg2: mem<all>, %arg3: world) -> (bits<32>, mem<all>, world) cc = target_default visibility=internal
    effects { reads={all}, writes={all}, volatile=false, atomic=false, io=false, fenv=false, may_trap=true, may_unwind=false }
{
^entry(%v0: bits<32>, %v1: bits<32>, %v2: mem<all>, %v3: world):
    (%v4, %v5, %v6) = alloca %v2, %v3 [origin=0, size=4, align=4]
    %v7 = access_in_bounds %v5, %v4 [size=4, align=4]
    (%v8, %v9) = store %v7, %v6, %v4, %v0
    %v10 = access_in_bounds %v8, %v4 [size=4, align=4]
    (%v11, %v12, %v13) = load %v10, %v9, %v4 : bits<32>
    (%v14, %v15) = lifetime.end %v12, %v13, %v4
    ret %v11, %v14, %v15
}

func @private_call_loop(%arg0: bits<32>, %arg1: bits<32>, %arg2: mem<all>, %arg3: world) -> (bits<32>, mem<all>, world) cc = target_default
    effects { reads={all}, writes={all}, volatile=false, atomic=false, io=false, fenv=false, may_trap=true, may_unwind=false }
{
^entry(%v0: bits<32>, %v1: bits<32>, %v2: mem<all>, %v3: world):
    (%v4, %v5, %v6) = alloca %v2, %v3 [origin=1, size=4, align=4]
    %v7 = access_in_bounds %v5, %v4 [size=4, align=4]
    (%v8, %v9) = store %v7, %v6, %v4, %v1
    br ^b1(%v0, %v4, %v8, %v9)

^b1(%v10: bits<32>, %v11: ptr<generic>, %v12: mem<all>, %v13: world):
    %v14 = const.bits<32> 0
    %v15 = icmp.ne %v10, %v14
    cond_br %v15, ^b2(%v10, %v11, %v12, %v13), ^b3(%v11, %v12, %v13)

^b2(%v16: bits<32>, %v17: ptr<generic>, %v18: mem<all>, %v19: world):
    %v20 = access_in_bounds %v18, %v17 [size=4, align=4]
    (%v21, %v22, %v23) = load %v20, %v19, %v17 : bits<32>
    (%v24, %v25, %v26) = call @private_keep(%v21, %v16, %v22, %v23)
    %v27 = const.bits<32> 1
    %v28 = add.bits<32> %v24, %v27
    %v29 = sub.bits<32> %v16, %v27
    %v30 = access_in_bounds %v25, %v17 [size=4, align=4]
    (%v31, %v32) = store %v30, %v26, %v17, %v28
    br ^b1(%v29, %v17, %v31, %v32)

^b3(%v33: ptr<generic>, %v34: mem<all>, %v35: world):
    %v36 = access_in_bounds %v34, %v33 [size=4, align=4]
    (%v37, %v38, %v39) = load %v36, %v35, %v33 : bits<32>
    (%v40, %v41) = lifetime.end %v38, %v39, %v33
    ret %v37, %v40, %v41
}
