func @mul(%arg0: f64, %arg1: f64, %arg2: f64, %arg3: f64, %arg4: mem<all>, %arg5: world) -> (f64, f64, mem<all>, world) cc = target_default
    effects { reads={}, writes={}, volatile=false, atomic=false, io=false, fenv=false, may_trap=false, may_unwind=false }
{
^entry(%v0: f64, %v1: f64, %v2: f64, %v3: f64, %v4: mem<all>, %v5: world):
    %v6 = fp.cmul.real %v0, %v1, %v2, %v3 : f64
    %v7 = fp.cmul.imag %v0, %v1, %v2, %v3 : f64
    ret %v6, %v7, %v4, %v5
}

