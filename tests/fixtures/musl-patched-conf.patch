diff --git a/src/conf/fpathconf.c b/src/conf/fpathconf.c
--- a/src/conf/fpathconf.c
+++ b/src/conf/fpathconf.c
@@ -1,9 +1,19 @@
 #include <unistd.h>
 #include <limits.h>
 #include <errno.h>
+#include <sys/statfs.h>
 
 long fpathconf(int fd, int name)
 {
+	if (name == _PC_TIMESTAMP_RESOLUTION) {
+		struct statfs fs;
+		if (fstatfs(fd, &fs)) return -1;
+		/* Linux shmem sets s_time_gran=1. Do not invent a resolution
+		   for other filesystems: Linux statfs does not expose it. */
+		if ((unsigned long)fs.f_type == 0x01021994) return 1;
+		errno = EINVAL;
+		return -1;
+	}
 	static const short values[] = {
 		[_PC_LINK_MAX] = _POSIX_LINK_MAX,
 		[_PC_MAX_CANON] = _POSIX_MAX_CANON,
diff --git a/src/conf/pathconf.c b/src/conf/pathconf.c
--- a/src/conf/pathconf.c
+++ b/src/conf/pathconf.c
@@ -1,6 +1,19 @@
 #include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
 
 long pathconf(const char *path, int name)
 {
+	if (name == _PC_TIMESTAMP_RESOLUTION) {
+		/* O_PATH neither reads data nor blocks on FIFOs. Follow symlinks,
+		   then query the same object through its stable descriptor. */
+		int fd = open(path, O_PATH|O_CLOEXEC);
+		if (fd < 0) return -1;
+		long result = fpathconf(fd, name);
+		int saved = errno;
+		close(fd);
+		errno = saved;
+		return result;
+	}
 	return fpathconf(-1, name);
 }
