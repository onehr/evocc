+/* Process a POSIX.1-2024 dollar-single-quote body that starts after $'.
+ * Return its terminating quote, or 0 when it is unterminated or uses an
+ * escape whose result is unspecified. With o, append the yielded bytes as
+ * one single-quoted string, which every POSIX shell reads the same way.
+ * A yielded null byte discards the rest of the body, one of the two
+ * permitted behaviors. */
+static const char *dollar_quote(const char *s, char **o)
+{
+	int c, d, n, nul = 0;
+	char *p = o ? *o : 0;
+
+	if (p) *p++ = '\'';
+	for (;; s++) {
+		c = (unsigned char)*s;
+		if (!c) return 0;
+		if (c == '\'') break;
+		if (c == '\\') switch ((c = (unsigned char)*++s)) {
+		case '"':
+		case '\'':
+		case '\\':
+			break;
+		case 'a': c = '\a'; break;
+		case 'b': c = '\b'; break;
+		case 'e': c = 033; break;
+		case 'f': c = '\f'; break;
+		case 'n': c = '\n'; break;
+		case 'r': c = '\r'; break;
+		case 't': c = '\t'; break;
+		case 'v': c = '\v'; break;
+		case 'c':
+			c = (unsigned char)*++s;
+			if (c == '\\' && s[1] == '\\') s++, c = 034;
+			else if (c == '?') c = 0177;
+			else if ((unsigned)c-'A' <= '_'-'A' && c != '\\') c &= 037;
+			else if ((unsigned)c-'a' < 26) c &= 037;
+			else return 0;
+			break;
+		case 'x':
+			for (n=c=0; n<3 && (d = hexdigit(s[1])) >= 0; n++, s++)
+				c = 16*c + d;
+			if (n < 1 || n > 2) return 0;
+			break;
+		case '0': case '1': case '2': case '3':
+		case '4': case '5': case '6': case '7':
+			c -= '0';
+			for (n=1; n<3 && (unsigned)s[1]-'0' < 8; n++, s++)
+				c = 8*c + s[1]-'0';
+			if (c > 255) return 0;
+			break;
+		default:
+			return 0;
+		}
+		if (!c) nul = 1;
+		if (!p || nul) continue;
+		if (c == '\'') {
+			memcpy(p, "'\\''", 4);
+			p += 4;
+		} else {
+			*p++ = c;
+		}
+	}
+	if (p) {
+		*p++ = '\'';
+		*o = p;
+	}
+	return s;
+}
