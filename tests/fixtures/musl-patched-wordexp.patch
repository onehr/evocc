+/* $c.. is a parameter expansion */
+static int varchar(int c)
+{
+	if (alnum(c)) return 1;
+	switch (c) {
+	case '_':
+	case '@':
+	case '*':
+	case '#':
+	case '?':
+	case '-':
+	case '$':
+	case '!':
