#!/bin/sh
# Opt-in N05 hook. Existing hooks must be composed, never overwritten.
# The hook runs only when evocc.codegenPlan names a committed live
# measurement plan. Without that setting the push proceeds.
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git config --get evocc.codegenPlan >/dev/null 2>&1; then
  exit 0
fi
exec python3 -m tools.ladder.codegen_push
